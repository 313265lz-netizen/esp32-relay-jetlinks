# Copy this file to `.env` and fill in your own values.
#   cp .env.example .env            (Linux / macOS)
#   copy .env.example .env          (Windows)

# ===== MQTT broker (JetLinks MQTT gateway) =====
MQTT_BROKER=127.0.0.1
MQTT_PORT=9783

# ===== MQTT credentials =====
MQTT_USERNAME=
MQTT_PASSWORD=

# ===== JetLinks product / device IDs (must match the platform) =====
GROUP_ID=8
SENSOR_PRODUCT_ID=sss1
SENSOR_DEVICE_ID=sss1
MODBUS_PRODUCT_ID=sss1
MODBUS_DEVICE_ID=modbus-01
RELAY_PRODUCT_ID=sss1
RELAY_DEVICE_ID=relay-g8

# ===== Modbus-TCP slave =====
MODBUS_HOST=127.0.0.1
MODBUS_PORT=5502
MODBUS_UNIT=1
